env:
    umask 077 && printf 'DATABASE_URL=postgresql://bugsigdb_poc:%s@pg_main:5432/bugsigdb_poc\n' \
      "$(gcloud secrets versions access latest --secret cdsci-bugsigdb-poc-db-password-onclappc02 --project cdsci-infra)" > .env

deploy: env
    docker compose up -d --build

load:
    docker compose run --rm app /app/.venv/bin/python -m bugsigdb_app.load

# Schema-changing release: build, load with the new image, then restart (seconds of mismatch)
release: env
    docker compose build
    docker compose run --rm app /app/.venv/bin/python -m bugsigdb_app.load
    docker compose up -d
